# ==========================================================================
# Conecta-Senac — variaveis de ambiente (MODELO)
# ==========================================================================
# Copie este arquivo para ".env" e preencha com os valores reais do seu
# ambiente. NUNCA versione o arquivo ".env" (ele ja esta no .gitignore).
#
#   cp .env.example .env     # Linux/macOS
#   copy .env.example .env   # Windows (PowerShell/CMD)
#
# Nenhum valor abaixo e real. Todos sao placeholders.
# ==========================================================================


# --------------------------------------------------------------------------
# 1) Servidor Node (pasta /server) — porta 3333 — MOCK LEGADO
#    Fonte da verdade do projeto e a API Spring Boot (secao 2). Este servidor
#    sobe apenas com o perfil "mock" do compose:
#      docker compose --profile mock up -d server
#    NAO rode mock e API juntos sobre o mesmo cliente: sao bases separadas
#    (JSON x Postgres) e uma sincronizacao entre as duas corrompe os dados.
# --------------------------------------------------------------------------
PORT=3333
# Somente exibida no log de inicializacao (nao controla bind).
PUBLIC_URL=http://localhost:3333


# --------------------------------------------------------------------------
# 2) API Spring Boot (pasta /backend/demo) - porta 8081 - FONTE DA VERDADE
#
#    POSTGRES_PASSWORD e a variavel que CONTROLA TUDO da stack local:
#    ela e usada tanto pelo servico "postgres" (para criar o role) quanto
#    pela API (para conectar). Preencha-a com uma senha forte.
#
#    Se voce deixar em branco, o Compose ABORTA na hora de subir com a
#    mensagem "POSTGRES_PASSWORD e obrigatorio" - e nao com um container em
#    crash loop.
#
#    IMPORTANTE: a senha do Postgres so e aplicada na PRIMEIRA inicializacao
#    do volume. Se voce ja subiu a stack e agora troca a senha, ela NAO muda:
#    recrie o volume com "docker compose down -v" antes de subir de novo.
# --------------------------------------------------------------------------
# Porta da API (padrao do projeto: 8081)
API_PORT=8081
# Usuario do Postgres/Supabase usado pela API
SUPABASE_DB_USER=
# Senha do Postgres/Supabase usado pela API
# (so e usada se voce rodar o backend FORA do Compose, contra o Supabase real.
#  Dentro do Compose, quem manda e POSTGRES_PASSWORD, abaixo.)
SUPABASE_DB_PASSWORD=

# Segredo de assinatura dos tokens JWT (minimo 32 caracteres).
# Gere com: openssl rand -base64 32  (ou qualquer string aleatoria longa)
# NUNCA reutilize a mesma chave em ambientes diferentes.
JWT_SECRET=

# Validade do token JWT em milissegundos (padrao: 24 horas = 86400000)
JWT_EXPIRATION_MS=86400000


# --------------------------------------------------------------------------
# 3) Postgres local via Docker Compose (arquivo compose.yaml na raiz)
#    use "docker compose up -d" na raiz do repositorio.
# --------------------------------------------------------------------------
POSTGRES_USER=postgres
# OBRIGATORIA. Senha do Postgres local. Tem de ser a mesma usada pela API.
POSTGRES_PASSWORD=
POSTGRES_DB=conectasenac
POSTGRES_PORT=5432


# --------------------------------------------------------------------------
# 4) App mobile (Expo) — opcional
#    Precedencia da URL da API:
#      1. bloco "extra" em mobile/app.json (versionavel — recomendado)
#      2. EXPO_PUBLIC_API_URL (injetada no bundle pelo Metro/.env do Expo)
#      3. descoberta automatica: hostUri do Expo Go (fallback 10.0.2.2 para
#         emulador Android) + EXPO_PUBLIC_API_PORT
#
#    Porta padrao: 8081 (API Spring Boot = fonte da verdade).
#    Para apontar ao mock legado, use a porta 3333.
#
#      "extra": { "apiUrl": "http://192.168.0.10:8081" }
# --------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8081
# Porta usada quando EXPO_PUBLIC_API_URL nao esta definida.
# EXPO_PUBLIC_API_PORT=8081
# Valor "same-origin" = usar a origem da propria pagina.
# EXPO_PUBLIC_MODO_API=mock|producao


# --------------------------------------------------------------------------
# 5) Frontend web (Vite) — opcional
#    O web le destas variaveis de tres fontes, nesta ordem:
#      1. window.__CONECTA_API_BASE__ / __CONECTA_MODO_API__ (injetado em runtime)
#      2. VITE_API_BASE / VITE_MODO_API (injetadas no bundle pelo Vite)
#      3. inferencia automatica (host loopback => 'mock', senao => 'producao')
#
#    Use o valor "same-origin" quando o frontend for servido pelo proprio
#    backend Java (imagem unica do Dockerfile). NAO use string vazia: o Vite
#    descarta variaveis com valor "" e o import.meta.env gerado vira {}.
# --------------------------------------------------------------------------
# VITE_API_BASE=http://127.0.0.1:8081
# VITE_API_BASE=same-origin
# VITE_MODO_API=mock|producao
# Tempo maximo de espera da API em ms antes de cair no modo offline.
# VITE_API_TIMEOUT_MS=12000