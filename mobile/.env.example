# ==========================================================================
# Conecta-Senac - mobile (Expo) - variaveis de ambiente (MODELO)
# ==========================================================================
# Copie para ".env" (nao versionado) e preencha com valores do seu ambiente.
# O Expo injeta variaveis EXPO_PUBLIC_* no bundle em tempo de build.
#
# Nenhum valor abaixo e real. Todos sao placeholders.
# ==========================================================================

# Endereco base da API Spring Boot central.
# Precedencia:
#   1. EXPO_PUBLIC_API_URL (esta variavel)
#   2. extra.apiUrl em app.json
#   3. (apenas em desenvolvimento) descoberta automatica pelo host do Expo
#
# Producao (Vercel web usa este host como referencia):
#   EXPO_PUBLIC_API_URL=https://conecta-senac.onrender.com
# Teste/preview:
#   EXPO_PUBLIC_API_URL=https://conecta-senac-test.onrender.com
# Desenvolvimento local (Spring Boot):
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:8081
EXPO_PUBLIC_API_URL=

# Ambiente logico do build (verificacao de coerencia apenas).
# A identidade AUTORITATIVA do build vem de app.config.js, que le
# EAS_BUILD_PROFILE no servidor EAS e injeta em extra.buildProfile.
# EXPO_PUBLIC_APP_ENV nao deve contradizer o perfil real.
# development | preview | production.
EXPO_PUBLIC_APP_ENV=

# Observacao: EXPO_PUBLIC_API_PORT foi removida. A descoberta automatica
# de host foi eliminada; o endereco da API deve ser explicito.

# ==========================================================================
# Perfis do eas.json e variaveis esperadas em cada um
# ==========================================================================
# development  (Expo Go / dev client):
#   - EXPO_PUBLIC_APP_ENV=development (ou confiar em __DEV__)
#   - EXPO_PUBLIC_API_URL pode ficar vazio (descoberta automatica pelo Metro)
#   - EXPO_PUBLIC_API_PORT=8081
#
# preview (build interno de teste):
#   - EXPO_PUBLIC_APP_ENV=preview
#   - EXPO_PUBLIC_API_URL=https://conecta-senac-test.onrender.com
#   - EXPO_PUBLIC_API_PORT=8081
#
# production (build de distribuicao):
#   - EXPO_PUBLIC_APP_ENV=production
#   - EXPO_PUBLIC_API_URL=https://conecta-senac.onrender.com
#   - EXPO_PUBLIC_API_PORT=8081
#   OBRIGATORIO: sem EXPO_PUBLIC_API_URL a build de producao falha
#   (sem fallback silencioso para host de teste).
# ==========================================================================
"