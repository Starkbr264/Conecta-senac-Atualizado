# ==========================================================================
# Conecta-Senac — .gitignore da raiz
# ==========================================================================

# --- Dependencias ---------------------------------------------------------
node_modules/
jspm_packages/

# --- Builds / artefatos ---------------------------------------------------
dist/
web-build/
build/
out/
*.tsbuildinfo

# --- Expo / React Native --------------------------------------------------
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# --- Gradle / Java --------------------------------------------------------
.gradle/
bin/
*.class
*.log

# --- Variáveis de ambiente e segredos ------------------------------------
# NUNCA versione .env (contem credenciais). Somente o exemplo ficticio
# (.env.example) fica versionado. A ordem importa: a excecao deve vir
# DEPOIS do padrao para ser aplicada pelo Git.
.env
.env.*
!.env.example
!.env.*.example

# --- Ferramentas / IDEs ---------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db

# --- Temporarios ----------------------------------------------------------
*.zip
*.tmp
*~
cache/

# --- Base local do Postgres (docker compose) ------------------------------
# ATENCAO: server/data/db.json e dado versionado do Conecta-Senac e NAO deve
# ser ignorado. Somente volumes/artefatos de build sao descartados.
# --------------------------------------------------------------------------
# ATENCAO: o .env NAO deve ser versionado. Ele contem credenciais reais
# (Supabase/Postgres) e, se historicamente versionado, essas credenciais
# devem ser consideradas comprometidas e rotacionadas (ver docs).
# As credenciais de producao (Supabase/Render) sao definidas no
# painel de cada servico; o .env local e apenas copia de desenvolvimento.
# --------------------------------------------------------------------------

.vercel
